&lt;div class="notices success" data-title="Success">
success text
&lt;/div>
&lt;div class="notices info" data-title="Info">
info text
&lt;/div>
&lt;div class="notices warning" data-title="Warning">
warning text
&lt;/div>
&lt;div class="notices error" data-title="Error">
error text
&lt;/div>
